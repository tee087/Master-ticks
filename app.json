{
  "name": "Ticketmaster",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/image.png",
  "userInterfaceStyle": "automatic",
  "assetBundlePatterns": [
    "**/*"
  ],
  "plugins": [
    [
      "expo-image-picker",
      {
        "photosPermission": "Allow Ticketmaster to access your photos so you can choose a profile image."
      }
    ]
  ],
  "ios": {
    "supportsTablet": true
  },
  "android": {
    "package": "com.ticketmaster",
    "permissions": [
      "android.permission.RECORD_AUDIO"
    ]
  },
  "web": {},
  "extra": {
      "ticketmasterBackendUrl": "https://master-ticks.onrender.com",
    "eas": {
      "projectId": "681dde71-e61f-45b9-ae19-deeeec56d357"
    }
  },
  "owner": "tee087"
}
