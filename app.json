{
  "name": "Ticketmaster",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/image.png",
  "userInterfaceStyle": "automatic",
  "assetBundlePatterns": [
    "**/*"
  ],
  "plugins": [
    [
      "expo-image-picker",
      {
        "photosPermission": "Allow Ticketmaster to access your photos so you can choose a profile image."
      }
    ],
    [
      "react-native-maps",
      {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY_HERE"
      }
    ]
  ],
  "ios": {
    "supportsTablet": true
  },
  "android": {
    "package": "com.ticketmaster",
    "permissions": [
      "android.permission.RECORD_AUDIO"
    ]
  },
  "web": {},
  "extra": {
    "eas": {
      "projectId": "d4e5c938-a9c4-4b66-bc3f-7709f445af3a"
    }
  },
  "owner": "tituskipkirui008"
}
