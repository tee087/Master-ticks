# Create a local .env file and add your Ticketmaster Discovery API consumer key.
# Get a key at https://developer.ticketmaster.com/
EXPO_PUBLIC_TICKETMASTER_API_KEY=your_ticketmaster_consumer_key

# Optional: URL of the local Python live-feed backend (cf_clearance pattern).
# When set, the app subscribes to real-time events streamed from the backend
# instead of relying solely on the public Discovery API key above.
# Start the backend with: python backend/server.py
EXPO_PUBLIC_TICKETMASTER_BACKEND_URL=http://localhost:8765
