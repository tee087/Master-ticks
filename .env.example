# Create a local .env file and add your Ticketmaster Discovery API consumer key.
# Get a key at https://developer.ticketmaster.com/
EXPO_PUBLIC_TICKETMASTER_API_KEY=your_ticketmaster_consumer_key

# Required for Google Maps tiles in Android and iOS development/release builds.
# Create a key in Google Cloud and restrict it to this app's Android package
# (com.ticketmaster) / iOS bundle identifier before using it.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
